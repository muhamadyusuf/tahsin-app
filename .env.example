# Salin ke .env.local (dev) / atur sebagai Environment Variable di Vercel (prod).
# JANGAN commit file .env berisi nilai asli.

# Clerk — hanya PUBLISHABLE key yang boleh ada di client (prefix EXPO_PUBLIC_).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Convex
EXPO_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud
# Dipakai halaman perangkap & endpoint HTTP (…/trap/*, …/iot/*)
EXPO_PUBLIC_CONVEX_SITE_URL=https://<deployment>.convex.site
CONVEX_DEPLOYMENT=dev:<deployment>

EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME=

# Google reCAPTCHA v3 (site key saja; secret ada di env Convex: RECAPTCHA_SECRET_KEY)
EXPO_PUBLIC_RECAPTCHA_SITE_KEY=

# TIDAK dipakai aplikasi client. Jangan simpan CLERK_SECRET_KEY di file .env proyek ini;
# rahasia server (Clerk secret, GEMINI_API_KEY, GDRIVE_*, RECAPTCHA_SECRET_KEY) diatur
# lewat `npx convex env set` / dashboard Vercel.
